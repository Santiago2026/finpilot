# FinPilot backend - plantilla de variables de entorno.
# Copiar este archivo a `.env` y ajustar los valores.
# NO incluir secretos reales en este archivo ni en el repositorio.

# --- Conexión con Apache Fineract ---
# URL base del contexto de Fineract (sin el prefijo /api/v1).
FINERACT_BASE_URL=https://localhost:8443/fineract-provider
# Tenant por defecto configurado en el entorno local de Fineract.
FINERACT_TENANT_ID=default
# Credenciales de servicio. Dejar vacías en la plantilla; definirlas solo en `.env`.
FINERACT_USERNAME=
FINERACT_PASSWORD=
# Tiempo máximo de espera por petición, en segundos.
FINERACT_TIMEOUT_SECONDS=10
# Validación del certificado TLS activada por defecto.
# Poner en false SOLO para el certificado autofirmado del entorno local de
# desarrollo; nunca en un entorno compartido o productivo.
FINERACT_VERIFY_TLS=true

# --- Autorización temporal del mecanismo de aprobaciones ---
# Token de servicio que autorizará las operaciones de aprobación.
# Debe permanecer vacío hasta que la lógica de aprobación esté implementada.
APPROVAL_API_TOKEN=
# Vigencia de una solicitud de aprobación, en segundos.
APPROVAL_TTL_SECONDS=900

# --- Límites de operaciones ---
# Monto máximo permitido para una operación, en la moneda de Fineract.
POLICY_MAX_TRANSACTION_AMOUNT=1000.00
# Monto a partir del cual una operación requiere aprobación humana.
POLICY_APPROVAL_THRESHOLD_AMOUNT=100.00

# --- Logging ---
LOG_LEVEL=INFO

# --- Documentación de la API ---
# Expone /docs, /redoc y /openapi.json. Deshabilitado por defecto para reducir la
# superficie expuesta; habilitar solo en desarrollo local.
API_DOCS_ENABLED=false

# --- Servidor MCP (streamable HTTP) ---
# Deshabilitado por defecto. Al habilitarlo, /mcp queda montado y en desarrollo
# debe accederse SOLO desde localhost; no exponerlo en una red accesible.
MCP_ENABLED=false
# Token opcional exigido en la cabecera X-MCP-Token al invocar /mcp.
# Es una guarda de desarrollo, no un mecanismo de autorización. Dejar vacío en
# la plantilla; definirlo solo en `.env` si se usa.
MCP_DEV_TOKEN=

