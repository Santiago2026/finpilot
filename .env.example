FINERACT_BASE_URL=https://fineract-fineract-1:8443/fineract-provider
FINERACT_USERNAME=replace-me-with-local-sandbox-user
FINERACT_PASSWORD=replace-me-with-local-sandbox-password
FINERACT_TENANT_ID=default
# Solo sandbox local con certificado autofirmado; en entornos con CA confiable usa true.
FINERACT_VERIFY_TLS=false
# Bundle CA opcional para verificar TLS cuando FINERACT_VERIFY_TLS=true.
# FINERACT_CA_BUNDLE=/ruta/al/bundle-de-ca.pem

# Servidor MCP Streamable HTTP local del mismo contenedor.
MCP_ENABLED=true
MCP_URL=http://127.0.0.1:8000/mcp/
# Opcional: si se establece, API Gateway lo envía como X-MCP-Token.
MCP_DEV_TOKEN=

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite+aiosqlite:////data/finpilot.db

MODEL_PROVIDER=huggingface
HF_TOKEN=
HF_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
HF_PROVIDER=auto
HF_MAX_NEW_TOKENS=1024

WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=finpilot

# Habilita tools de escritura protegidas por aprobación HITL. Mantener false
# fuera del sandbox de demostración configurado.
WRITES_ENABLED=true
FINPILOT_DASHBOARD_PORT=8502

AUTH_DISABLED=false
